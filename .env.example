# YKR World Environment Variables

# Server Port
PORT=3000

# Secret for JWT signing (Change this in production to a random 32+ character string)
SECRET=ykr-world-super-secret-key-change-in-production

# Demo OTP: Set to a fixed 6-digit code for testing (e.g. 123456).
# Leave blank or remove in production to send real dynamic OTPs.
DEMO_OTP=123456

# ========================================================
# FAST SMS OTP CONFIGURATION (CHOOSE ONE PROVIDER)
# ========================================================

# Option 1: Fast2SMS (Recommended in India - Instant signup, no DLT required for Quick OTP route)
# Sign up at https://www.fast2sms.com -> Dev API -> Copy Authorization Key
FAST2SMS_API_KEY=

# Option 2: 2Factor.in (Very reliable, instant SMS OTP across India)
# Sign up at https://2factor.in -> API Key
TWOFACTOR_API_KEY=

# Option 3: Custom SMS Gateway URL (Any provider - Textlocal, MSG91, Kaleyra, etc.)
# Supports {mobile} and {otp} placeholders:
# SMS_GATEWAY_URL=https://api.example.com/send?apikey=YOUR_KEY&number={mobile}&message=Your+YKR+World+OTP+is+{otp}
SMS_GATEWAY_URL=
