PORT=3000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@ykrworld.in
ADMIN_MOBILE=9999999999
ADMIN_NAME=YKR Admin
# Razorpay (leave blank + MOCK_PAYMENTS=true for local testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_PAYMENTS=true
# Dev only: returns the OTP in the API response so you can log in without SMS
DEV_SHOW_OTP=true

# Email OTP Configuration (Gmail App Password or SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password
SMTP_FROM="YKR World" <your-email@gmail.com>
